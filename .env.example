# Faun — AI Forest Monitoring System
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# === Required secrets ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_DRONE_BOT_TOKEN=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=

# === AI Studio (RAG / DataSphere) ===
SEARCH_INDEX_ID=
DATASPHERE_NODE_ID=

# === YDB Serverless (enables persistent cloud storage) ===
# When set, the system switches from SQLite to YDB automatically.
# YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135
# YDB_DATABASE=/ru-central1/b1g.../etn...
# YDB_SA_KEY_FILE=/app/sa-key.json

# === Security (FAUN-37) ===
# API key required for all mutating endpoints. Generate via `openssl rand -hex 32`.
FAUN_API_KEY=
# Comma-separated chat IDs allowed to interact with @faun_forest_bot. Empty = allow all (dev).
ALLOWED_RANGER_CHAT_IDS=
# Comma-separated chat IDs allowed to interact with @faun_drone_bot. Empty = allow all (dev).
ALLOWED_DRONE_CHAT_IDS=

# === Telegram bot extras ===
# Comma-separated chat IDs allowed to receive admin notifications.
# ADMIN_CHAT_IDS=
# Quiet hours during which non-critical alerts are suppressed (24h, server TZ).
# QUIET_HOURS_START=23
# QUIET_HOURS_END=7

# === Edge / classifier wiring ===
# EDGE_CLASSIFY_URL=http://edge:8001/classify
# EDGE_CLASSIFY_PORT=8001
# RAG_SDK_TIMEOUT=15

# === Microphone deployment ===
# MIC_MODE=sim                  # sim | live
# MIC_DEVICE_IDS=mic-a,mic-b,mic-c
# MIC_GRID_SPACING_M=1500
# TDOA_N_MICS=6
# MICS_DB_PATH=/app/cloud/db/microphones.sqlite
# RANGERS_DB_PATH=/app/cloud/db/rangers.sqlite
# PERMITS_DB_PATH=/app/cloud/db/permits.sqlite

# === Demo / runtime ===
# DEMO_SCENARIO=chainsaw
# DISABLE_AUTO_DEMO=0
# MIN_DEMO_MEMORY_MB=512

# === Optional (defaults shown) ===
# ALERT_COOLDOWN_SECONDS=300
# CLOUD_API_URL=http://cloud:8000
# LORA_GATEWAY_HOST=lora_gateway
# LORA_GATEWAY_PORT=9000
# LORA_FREQ_MHZ=868.0
# YANDEX_WORKFLOWS_ENDPOINT=

# === Microphone coordinates (defaults: Moscow test area) ===
# MIC_A_LAT=55.7510
# MIC_A_LON=37.6130
# MIC_B_LAT=55.7515
# MIC_B_LON=37.6138
# MIC_C_LAT=55.7508
# MIC_C_LON=37.6142
